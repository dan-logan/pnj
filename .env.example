# Firebase web config for remote multiplayer. Copy to `.env` and fill in the
# four values printed by scripts/setup-firebase.sh.
#
# These are PUBLIC by design. Firebase's own documentation is explicit that the
# web API key is an identifier, not a credential — the security model rests
# entirely on firestore/firestore.rules, not on keeping these secret. They are
# baked into the static GitHub Pages build, and are stored in CI as repository
# *variables* (not secrets); see .github/workflows/deploy.yml.
#
# With any of the four missing, the app builds and plays solo with no
# multiplayer UI — which is exactly what keeps CI (which has none of them) green.
# So `.env` is optional; solo development needs nothing here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Local emulator (optional) ----------------------------------------------
# Uncomment to point the app at a running Firestore/Auth emulator instead of the
# live project (see `npm run emulators`). Leave commented for production builds.
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
